// Rename to tick_scripts/<udf_name>.tick. <udf_name> must match udfs.name in
// config.json and the .py file under udfs/ -- see ../references/tickscript-basics.md.

dbrp "datain"."autogen"
var data0 = stream
        |from()
                // Must equal the "topic" field you send to POST /input --
                // topic becomes the InfluxDB measurement name.
                .measurement('point_data')
data0
    @pressure_guard()

// Optional: publish anomalies via Kapacitor's native MQTT alert handler
// (only works if config.json's alerts.mqtt is set -- see
// ../references/tickscript-basics.md#mqtt-alerting):
//
// data0
//     @pressure_guard()
//     |alert()
//         .message('Anomaly detected: {{ index .Fields "value" }}')
//         .mqtt('REPLACE_WITH_MQTT_BROKER_NAME')
